PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_events

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# Optional: if these are left blank, booking confirmation emails are
# logged to the console instead of actually sent (useful for local dev
# and grading without needing real SMTP credentials).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Campus Events <no-reply@campus-events.local>
